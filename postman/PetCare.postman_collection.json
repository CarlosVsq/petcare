{
  "info": {
    "name": "PetCare",
    "description": "Endpoints de la API PetCare. Ejecutar en orden con la aplicación recién iniciada y el servicio de APIs externas en ejecución.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const hoy = new Date();",
          "const lunes = new Date(hoy.getFullYear(), hoy.getMonth(), hoy.getDate() - ((hoy.getDay() + 6) % 7) + 7);",
          "const formato = (d) => `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;",
          "const sumar = (d, n) => new Date(d.getFullYear(), d.getMonth(), d.getDate() + n);",
          "pm.collectionVariables.set('lunes', formato(lunes));",
          "pm.collectionVariables.set('miercoles', formato(sumar(lunes, 2)));"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "lunes",
      "value": ""
    },
    {
      "key": "miercoles",
      "value": ""
    },
    {
      "key": "clienteId",
      "value": ""
    },
    {
      "key": "mascotaId",
      "value": ""
    },
    {
      "key": "mascotaTemporalId",
      "value": ""
    },
    {
      "key": "reservaId",
      "value": ""
    },
    {
      "key": "clienteTemporalId",
      "value": ""
    }
  ],
